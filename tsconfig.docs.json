{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@weave/core": ["packages/core/src/index.ts"],
      "@weave/core/protocol": ["packages/core/src/protocol.ts"]
    }
  },
  "include": ["packages/core/src", "packages/storage/src", "packages/transport/src"]
}
