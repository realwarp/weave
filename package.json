{
  "name": "weave-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "WEAVE: an offline-first application foundation (monorepo)",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run -c tests/browser/vitest.config.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:license": "node scripts/check-license.mjs",
    "audit": "npm audit --omit=dev",
    "bench": "node scripts/bench.mjs",
    "dev:ghostline": "node scripts/dev.mjs ghostline",
    "dev:fieldnote": "node scripts/dev.mjs fieldnote",
    "demo:ghostline": "node scripts/demo.mjs ghostline",
    "demo:fieldnote": "node scripts/demo.mjs fieldnote",
    "docs:api": "typedoc",
    "typecheck:tests": "tsc -p packages/core/tsconfig.test.json && tsc -p packages/storage/tsconfig.test.json && tsc -p packages/transport/tsconfig.test.json && tsc -p packages/relay/tsconfig.test.json && tsc -p packages/testing/tsconfig.test.json && tsc -p tests/tsconfig.json && tsc -p apps/ghostline/tsconfig.json && tsc -p apps/fieldnote/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@vitest/browser": "^2.1.9",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.15.0",
    "fast-check": "^3.23.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typedoc": "^0.27.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.17.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
